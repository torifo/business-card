---
/**
 * 名刺の表面 (FR-001)。
 * 物理名刺の比率 (91:55 ≒ 1.65:1) を意識した横長レイアウト。
 * 左に円形アバター、右に氏名・肩書・tagline・SNS / 連絡先リンクを縦並びで配置する。
 *
 * Profile は props 経由で受け取り、コンポーネント内でのハードコード値は持たない。
 * インタラクションは Wave 6 (card-flip.ts) で配線する。
 */
import type { Profile, ProfileLink } from "../types/card";

interface Props {
  profile: Profile;
  qrSvg: string;
}

const { profile, qrSvg } = Astro.props;

const LINK_LABEL: Record<ProfileLink["type"], string> = {
  github: "GH",
  x: "X",
  qiita: "Qiita",
  linkedin: "in",
  email: "Mail",
  portfolio: "Site",
};
---

<section class="card-front" aria-label="プロフィール表面">
  <div class="card-front__avatar-col">
    <img
      class="card-front__avatar"
      src={profile.avatarUrl}
      alt={`${profile.name} のアバター`}
      width="180"
      height="180"
      decoding="async"
    />
  </div>

  <div class="card-front__info-col">
    <div class="card-front__names">
      <h1 class="card-front__name-jp">{profile.name}</h1>
      <p class="card-front__name-en">{profile.nameEn}</p>
    </div>

    <p class="card-front__title">{profile.title}</p>
    <p class="card-front__tagline">{profile.tagline}</p>

    <ul class="card-front__links" aria-label="SNS / 連絡先">
      {
        profile.links.map((link) => {
          const isIconLink = link.type === "github" || link.type === "email";
          const isEmail = link.type === "email";
          // email URL に mailto: が無ければ自動付与し、メーラーで開けるようにする
          const href = isEmail && !/^mailto:/i.test(link.url)
            ? `mailto:${link.url}`
            : link.url;
          return (
            <li>
              <a
                class:list={["card-front__link", isIconLink && "card-front__link--icon"]}
                href={href}
                target={isEmail ? undefined : "_blank"}
                rel={isEmail ? undefined : "noopener noreferrer"}
                aria-label={`${LINK_LABEL[link.type]}: ${link.url}`}
              >
                {link.type === "github" && (
                  <svg
                    class="card-front__icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                  </svg>
                )}
                {isEmail && (
                  <svg
                    class="card-front__icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
                  </svg>
                )}
                {!isIconLink && LINK_LABEL[link.type]}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>

  <div class="card-front__qr" set:html={qrSvg} aria-hidden="true" />
</section>

<style>
  /*
   * サイズは全て cqi (= card-face 幅の 1%) ベースに統一。card-face は
   * container-type: inline-size 指定済 (card.css)。これで card 全体が
   * 大きくなったときに内部要素も比例拡大される (全画面モード時の対応)。
   */
  .card-front {
    height: 100%;
    display: grid;
    /* アバター列を細めて文字列に幅を譲る (38% → 33%) */
    grid-template-columns: minmax(0, 33%) minmax(0, 1fr);
    gap: 5cqi;
    padding: 4cqi;
    align-items: center;
    box-sizing: border-box;
    position: relative;
  }

  .card-front__avatar-col {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-front__avatar {
    width: 100%;
    max-width: 33cqi;
    aspect-ratio: 1 / 1;
    height: auto;
    border-radius: 50%;
    object-fit: cover;
    border: 0.5cqi solid var(--color-border);
    background: var(--color-surface);
  }

  .card-front__info-col {
    display: flex;
    flex-direction: column;
    gap: 2.8cqi;
    min-width: 0;
  }

  .card-front__names {
    display: flex;
    flex-direction: column;
    gap: 0.6cqi;
  }

  /* フォントサイズを全体的に bump up: name-jp 5→6.8, name-en 2.8→3.6,
     title 3.2→4, tagline 2.6→3.3。card 幅 358px の場合 name-jp は
     17.9px → 24.3px と一回り大きくなる。 */
  .card-front__name-jp {
    font-size: 6.8cqi;
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
    letter-spacing: 0.04em;
    line-height: 1.15;
  }

  .card-front__name-en {
    font-size: 4.8cqi;
    color: var(--color-text-muted);
    margin: 0;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .card-front__title {
    font-size: 4cqi;
    color: var(--color-accent);
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .card-front__tagline {
    font-size: 3.3cqi;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.4;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .card-front__links {
    list-style: none;
    padding: 0;
    margin: 1.5cqi 0 0;
    display: flex;
    gap: 2cqi;
    flex-wrap: wrap;
  }

  .card-front__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 8.5cqi;
    height: 8.5cqi;
    padding: 0 2.5cqi;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    font-size: 3.4cqi;
    font-weight: 600;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .card-front__link:hover,
  .card-front__link:focus-visible {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-bg);
  }

  /* アイコン用のリンクは正方形にしてラベル分のパディングを除く */
  .card-front__link--icon {
    padding: 0;
    width: 8.5cqi;
  }

  .card-front__icon {
    width: 5cqi;
    height: 5cqi;
    display: block;
  }

  .card-front__qr {
    position: absolute;
    bottom: 2.5cqi;
    right: 2.5cqi;
    width: 13cqi;
    height: 13cqi;
    background: white;
    border-radius: 1.5cqi;
    padding: 1cqi;
    box-sizing: border-box;
  }

  .card-front__qr svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
