---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "デジタル名刺" } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script>
      // FR-010: 初期テーマ即時適用 (Task 6.1) + 10 分タイマー (Task 6.2)。
      // FR-003: 表/裏のフリップ制御 (Task 6.3)。
      // Astro が Vite で transpile し defer 属性付き module として hoist する。
      // module は HTML パース完了後に実行されるため document.body と
      // #card-data / #card の両方にアクセス可能。
      import "../scripts/theme-init.inline.ts";
      import "../scripts/theme.ts";
      import "../scripts/card-flip.ts";
      import "../scripts/card-filter.ts";
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
